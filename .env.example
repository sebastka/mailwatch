# --- Monitored domains: DOMAIN_<n>_* for n = 1, 2, … (gaps are fine; n fixes the order) ---
# Every domain is checked (MX, SMTP, SPF, DKIM, DMARC, MTA-STS, TLS-RPT, DANE, BIMI, blocklists).
# With SMTP settings, it also sends a delivery test to every RECIPIENT_<n> every
# SEND_INTERVAL_MINUTES (default DELIVERY_INTERVAL_MINUTES). SMTP settings are all-or-nothing.
DOMAIN_1_NAME=wemail.no
DOMAIN_1_SMTPHOST=smtp.wemail.no
DOMAIN_1_SMTPPORT=465                  # 465 = implicit TLS; other ports require STARTTLS
DOMAIN_1_SMTPUSER=tester@wemail.no
DOMAIN_1_SMTPPASS=change-me            # DOMAIN_1_SMTPPASSWORD works too
# DOMAIN_1_FROM=tester@wemail.no       # default: SMTPUSER when it is an address
# DOMAIN_1_SEND_INTERVAL_MINUTES=60    # 0 = never send from this domain
# DOMAIN_1_DKIM_SELECTORS=s1,s2        # selectors to check besides the common ones (they cannot be listed from DNS)
# DOMAIN_1_SENDER_IPS=192.0.2.10       # outbound IPs to check against blocklists (delivery tests add the ones they see)
# DOMAIN_1_SMTPTLS=true                # default: true on port 465
# DOMAIN_1_TLS_REJECT_UNAUTHORIZED=true
#
DOMAIN_2_NAME=sol.dk
DOMAIN_2_SMTPHOST=smtp.sol.dk
DOMAIN_2_SMTPPORT=465
DOMAIN_2_SMTPUSER=tester@sol.dk
DOMAIN_2_SMTPPASS=change-me
#
# A domain that is only checked, never used to send:
# DOMAIN_3_NAME=example.org

# --- Delivery test recipients: RECIPIENT_<n>_* ---
# Dedicated test mailboxes at the providers you want to reach. MailWatch searches the Inbox and
# the Junk folder for its test messages, records where and how fast they arrived and how the
# provider authenticated them, then moves them to the trash.
RECIPIENT_1_NAME=GMail
RECIPIENT_1_IMAPHOST=imap.gmail.com
RECIPIENT_1_IMAPPORT=993
RECIPIENT_1_IMAPUSER=mygmailuser@gmail.com
RECIPIENT_1_IMAPPASSWORD=change-me     # a Google app password (needs 2-step verification); _IMAPPASS works too
# RECIPIENT_1_ADDRESS=mygmailuser@gmail.com  # default: IMAPUSER
# RECIPIENT_1_FOLDERS=INBOX,[Gmail]/Spam     # default: INBOX + the folder marked \Junk
# RECIPIENT_1_KEEP_MESSAGES=false            # true = leave found test messages in place
#
# Outlook.com no longer accepts passwords over IMAP: use OAuth2 (XOAUTH2) with a refresh token
# of an app registration that has the IMAP.AccessAsUser.All permission (see README).
RECIPIENT_2_NAME=Microsoft
RECIPIENT_2_IMAPHOST=outlook.office365.com
RECIPIENT_2_IMAPPORT=993
RECIPIENT_2_IMAPUSER=myoutlookuser@outlook.com
RECIPIENT_2_OAUTH_TOKEN_URL=https://login.microsoftonline.com/consumers/oauth2/v2.0/token
RECIPIENT_2_OAUTH_CLIENT_ID=change-me
RECIPIENT_2_OAUTH_REFRESH_TOKEN=change-me
# RECIPIENT_2_OAUTH_CLIENT_SECRET=      # confidential clients only
# RECIPIENT_2_OAUTH_SCOPE=https://outlook.office.com/IMAP.AccessAsUser.All offline_access

# --- Report mailboxes: MAILBOX_<n>_* ---
# Mailboxes receiving DMARC aggregate (rua), DMARC failure (ruf) and SMTP TLS (TLS-RPT) reports.
# One mailbox may receive all kinds; each message is classified by its content. Read-only,
# except for the opt-in cleanup.
# MAILBOX_1_NAME=Reports
# MAILBOX_1_IMAPHOST=imap.example.com
# MAILBOX_1_IMAPPORT=993
# MAILBOX_1_IMAPUSER=dmarc@example.com
# MAILBOX_1_IMAPPASS=change-me           # or OAuth2: MAILBOX_1_OAUTH_* as for recipients
# MAILBOX_1_ADDRESS=dmarc@example.com    # the address in rua=/ruf=, to mark it as monitored (default: IMAPUSER)
# MAILBOX_1_FOLDER=INBOX
# MAILBOX_1_IMAPTLS=true                 # default: true on port 993, STARTTLS otherwise
# MAILBOX_1_TLS_REJECT_UNAUTHORIZED=true
# MAILBOX_1_MAX_MESSAGE_BYTES=26214400
# Opt-in cleanup: permanently delete imported messages in the folder (only there) that were
# sent more than N months ago. Unset or 0 = never delete (default).
# MAILBOX_1_DELETE_AFTER_MONTHS=12
# MAILBOX_1_DELETE_DRY_RUN=true          # log what would be deleted, delete nothing

# --- Schedules ---
# CHECK_INTERVAL_MINUTES=15              # DNS and server checks of every domain; 0 = manual only
# CHECK_CONCURRENCY=4                    # domains checked in parallel
# REPORT_SYNC_INTERVAL_MINUTES=30        # report mailboxes; 0 = manual / CLI only
# REPORT_ANALYSIS_DAYS=7                 # report findings and their alerts look at this many days
# DELIVERY_INTERVAL_MINUTES=60           # default send interval of every sender domain
# DELIVERY_TIMEOUT_MINUTES=30            # a test message not found after this long is "lost"
# DELIVERY_POLL_SECONDS=60               # how often recipients are searched while messages are pending
# DELIVERY_RETENTION_DAYS=90             # delete older delivery results; 0 = keep

# --- Checks ---
# DNS_RESOLVERS=1.1.1.1,8.8.8.8          # validating resolvers (DNSSEC); "system" = the OS resolvers
# DNS_TIMEOUT_MS=4000
# SMTP_PROBE=true                        # connect to every MX on port 25 (STARTTLS, certificates, DANE)
# SMTP_PROBE_TIMEOUT_MS=20000
# SMTP_HELO_NAME=mailwatch.example.com   # default: the PUBLIC_URL host name
# CERT_WARN_DAYS=21                      # certificate expiry warning (7 days = error)
# HTTP_TIMEOUT_MS=10000                  # MTA-STS policy and BIMI fetches
# DKIM_COMMON_SELECTORS=default,dkim,…   # selectors tried for every domain; empty = only configured/seen ones
# DNSBL_ZONES=zen.spamhaus.org,bl.spamcop.net,psbl.surriel.com,bl.mailspike.net
# DNSBL_DOMAIN_ZONES=dbl.spamhaus.org,multi.surbl.org
# (Spamhaus and SURBL refuse queries through public resolvers: use your own resolver or a key.)

# --- Alerts ---
# ALERT_CONFIRMATIONS=2                  # consecutive checks a finding must be seen in before it alerts
# Telegram: alerts are posted by this bot to this chat (optional; both or neither)
# TELEGRAM_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=-1001234567890
# TELEGRAM_THREAD_ID=42                  # topic in a forum supergroup, optional
TIMEZONE=Europe/Oslo                     # times in the UI and in alerts, and quiet hours

# --- MariaDB (compose.yaml provides one for development, on port 3308) ---
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=mailwatch
DB_PASSWORD=mailwatch
DB_NAME=mailwatch
# DB_POOL_SIZE=5
# DB_TLS=false

# --- HTTP ---
# LISTEN_HOST=127.0.0.1                  # use 0.0.0.0 in containers
# PORT=3000

# --- OIDC login (required: the dashboard does not start without it) ---
# Register the redirect URI ${PUBLIC_URL}/auth/callback and post-logout URI ${PUBLIC_URL}/
PUBLIC_URL=https://mailwatch.example.com # external origin, no path; also used for links in alerts
OIDC_ISSUER=https://idp.example.com/realms/example
OIDC_CLIENT_ID=mailwatch
OIDC_CLIENT_SECRET=change-me
# OIDC_TOKEN_AUTH_METHOD=client_secret_basic  # or client_secret_post, client_secret_jwt, none (public client, no secret)
OIDC_ALLOWED_GROUPS=mailwatch            # comma/space separated; members of any of them get in
# OIDC_EDITOR_GROUPS=mailwatch-admins    # may change settings and send delivery tests on demand; unset = everyone allowed
# OIDC_GROUPS_CLAIM=groups               # or a nested path, e.g. realm_access.roles
# OIDC_SCOPES=openid profile email       # some providers need "groups" added to send the claim
# SESSION_TTL_HOURS=12
#
# Local mock provider (docker compose --profile oidc up -d); enter the claims
# {"groups": ["mailwatch"]} on its login form:
# PUBLIC_URL=http://localhost:5173
# OIDC_ISSUER=http://localhost:8080/default
# OIDC_CLIENT_ID=mailwatch
# OIDC_CLIENT_SECRET=anything
# OIDC_ALLOW_INSECURE_ISSUER=true

# --- Integration tests (npm test) against the compose MariaDB; unset to skip them ---
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=3308
# TEST_DB_USER=mailwatch
# TEST_DB_PASSWORD=mailwatch
# TEST_DB_NAME=mailwatch_test
# Mailbox tests against a DISPOSABLE IMAP server (docker compose --profile imap up -d)
# TEST_IMAP_HOST=127.0.0.1
# TEST_IMAP_PORT=31993
# TEST_IMAP_PASSWORD=secret
