{
  "name": "mailwatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monitoring dashboard for e-mail DNS and server setup (MX, SPF, DKIM, DMARC, MTA-STS, TLS-RPT, DANE, BIMI), DMARC and TLS reports, and end-to-end delivery tests",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server/index.ts",
    "sync": "node --env-file-if-exists=.env src/server/cli-sync.ts",
    "check-domain": "node --env-file-if-exists=.env src/server/cli-check.ts",
    "demo": "DB_NAME=mailwatch_demo node --env-file-if-exists=.env scripts/seed-demo.ts && DB_NAME=mailwatch_demo MAILWATCH_DEMO=true TELEGRAM_TOKEN= node --env-file-if-exists=.env src/server/index.ts",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --env-file-if-exists=.env --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "bundle": "bash scripts/bundle.sh",
    "docker:build": "docker build -t mailwatch:local ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "dns-packet": "^5.6.1",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.12",
    "imapflow": "^2.2.1",
    "mailparser": "^3.9.33",
    "mariadb": "^3.5.4",
    "nodemailer": "^10.0.13",
    "openid-client": "^6.8.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/dns-packet": "^5.6.5",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "yaml": "^2.9.1"
  }
}
